{
  "name": "Kiyeovo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Desktop client for a decentralized p2p messenger",
  "author": "Marin Dedic <marin.dedic1308@gmail.com>",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:ui dev:electron",
    "dev:ui": "vite",
    "dev:electron": "npm run transpile:electron && NODE_ENV=development electron .",
    "start:local": "npm run transpile:electron && npm run build && electron .",
    "start:local:debug": "npm run transpile:electron && npm run build && DEBUG_MODE=true electron .",
    "start:local:debug:net": "npm run transpile:electron && npm run build && DEBUG_MODE=true DEBUG=libp2p:circuit-relay*,libp2p:dcutr*,libp2p:connection-manager*,libp2p:upgrader* electron .",
    "build": "tsc -b && vite build",
    "test:unit": "cross-env ELECTRON_RUN_AS_NODE=1 electron --import tsx src/core/test-suite.ts",
    "test:e2e": "playwright test",
    "test:e2e:headless": "xvfb-run -a -s \"-screen 0 1280x800x24\" playwright test",
    "test:e2e:quick": "xvfb-run -a -s \"-screen 0 1280x800x24\" playwright test --grep-invert @slow",
    "lint": "eslint .",
    "bootstrap": "tsx src/core/bootstrap.ts",
    "relay": "tsx src/core/relay.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "check:server-deps": "node infrastructure/scripts/check-server-deps.mjs",
    "preview": "vite preview",
    "clean:electron": "node -e \"require('fs').rmSync('dist-electron', { recursive: true, force: true })\"",
    "transpile:electron": "npm run clean:electron && tsc -p src/electron/tsconfig.json && node scripts/build-preload.mjs",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64 --publish never",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --publish never",
    "download:tor": "bash scripts/download-tor.sh",
    "download:tor:all": "bash scripts/download-tor.sh all",
    "setup": "npm install && npm run download:tor",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@chainsafe/libp2p-gossipsub": "^14.1.2",
    "@chainsafe/libp2p-noise": "^16.1.4",
    "@chainsafe/libp2p-yamux": "^7.0.4",
    "@libp2p/bootstrap": "^11.0.43",
    "@libp2p/circuit-relay-v2": "^3.2.24",
    "@libp2p/crypto": "^5.1.7",
    "@libp2p/dcutr": "^2.0.38",
    "@libp2p/identify": "^3.0.37",
    "@libp2p/interface": "2.11.0",
    "@libp2p/interface-peer-store": "^2.0.4",
    "@libp2p/kad-dht": "^15.1.11",
    "@libp2p/mdns": "^11.0.46",
    "@libp2p/peer-id": "^5.1.8",
    "@libp2p/peer-id-factory": "^4.2.4",
    "@libp2p/ping": "^2.0.36",
    "@libp2p/tcp": "^10.1.17",
    "@multiformats/multiaddr": "^12.5.1",
    "@napi-rs/blake-hash": "^1.3.6",
    "@noble/ciphers": "^1.3.0",
    "@noble/curves": "^1.9.2",
    "@noble/hashes": "^1.6.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-toast": "^1.2.15",
    "@reduxjs/toolkit": "^2.11.2",
    "@scure/bip39": "^2.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mime-types": "^3.0.1",
    "better-sqlite3": "^12.6.2",
    "daisyui": "^5.5.14",
    "datastore-level": "^12.0.2",
    "dotenv": "^17.2.0",
    "emoji-picker-react": "^4.18.0",
    "it-pipe": "^3.0.1",
    "keytar": "^7.9.0",
    "libp2p": "^2.8.12",
    "lucide-react": "^0.562.0",
    "mime-types": "^3.0.2",
    "patch-package": "^8.0.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "read": "^5.0.1",
    "socks": "^2.8.6",
    "stream-to-it": "^1.0.1",
    "tailwindcss": "^4.1.18",
    "unique-names-generator": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/read": "^0.0.32",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  },
  "overrides": {
    "@libp2p/interface": "2.11.0"
  }
}
