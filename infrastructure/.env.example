# Copy to infrastructure/.env and fill in your server's public IPv4.
# These are the addresses clients dial; deploy mode aborts startup without them.
# (A DNS name would use /dns4/<host>/... instead of /ip4/<ip>/... — see Phase 3.)

BOOTSTRAP_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/9000
RELAY_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/4002
