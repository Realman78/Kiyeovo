# Recommended: run `./kiyeovo-infra fast init` or `./kiyeovo-infra anonymous init`.
# The CLI writes per-mode config under:
#
#   instances/fast/.env   # Fast bootstrap + relay (+ optional TURN)
#   instances/anon/.env   # Anonymous Tor onion bootstrap
#
# This file documents the Fast-mode keys for operators who need to inspect or
# hand-edit the generated config. These are the addresses clients dial; deploy
# mode aborts startup without them. A DNS name uses /dns4/<host>/... instead of
# /ip4/<ip>/...

BOOTSTRAP_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/9000
RELAY_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/4002

# Published/listen ports (optional; defaults shown). Keep the announce port above
# in sync with these.
BOOTSTRAP_PORT=9000
RELAY_PORT=4002
