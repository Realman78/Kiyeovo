# Copy to infrastructure/.env (or run `./kiyeovo-infra init`) and fill in your
# server's public IPv4. These are the addresses clients dial; deploy mode aborts
# startup without them. A DNS name uses /dns4/<host>/... instead of /ip4/<ip>/...

BOOTSTRAP_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/9000
RELAY_ANNOUNCE_ADDRS=/ip4/<public-ip>/tcp/4002

# Published/listen ports (optional; defaults shown). Keep the announce port above
# in sync with these.
BOOTSTRAP_PORT=9000
RELAY_PORT=4002
