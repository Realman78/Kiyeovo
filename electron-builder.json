{
    "appId": "com.marin-dedic.kiyeovo",
    "electronFuses": {
        "runAsNode": false,
        "enableNodeOptionsEnvironmentVariable": false,
        "enableNodeCliInspectArguments": false,
        "grantFileProtocolExtraPrivileges": false,
        "enableEmbeddedAsarIntegrityValidation": true
    },
    "files": ["dist-electron/**", "dist-ui/**", "package.json"],
    "extraResources": [
        {
            "from": "resources/icons",
            "to": "icons",
            "filter": ["**/*"]
        }
    ],
    "asarUnpack": [
        "resources/tor/**"
    ],
    "productName": "Kiyeovo",
    "linux": {
        "target": ["AppImage", "deb"],
        "category": "Network",
        "icon": "resources/icons",
        "executableName": "kiyeovo",
        "extraResources": [
            {
                "from": "resources/tor/linux-${arch}",
                "to": "tor/linux-${arch}",
                "filter": ["**/*"]
            }
        ]
    },
    "mac": {
        "target": [
            { "target": "dmg", "arch": ["arm64", "x64"] },
            { "target": "zip", "arch": ["arm64", "x64"] }
        ],
        "category": "public.app-category.social-networking",
        "icon": "resources/icons/app-icon.png",
        "identity": "-",
        "notarize": false,
        "extraResources": [
            {
                "from": "resources/tor/darwin-${arch}",
                "to": "tor/darwin-${arch}",
                "filter": ["**/*"]
            }
        ]
    },
    "win": {
        "target": ["nsis", "portable"],
        "icon": "resources/icons/app-icon.ico",
        "signtoolOptions": {
            "signingHashAlgorithms": ["sha256"]
        },
        "extraResources": [
            {
                "from": "resources/tor/win32-x64",
                "to": "tor/win32-x64",
                "filter": ["**/*"]
            }
        ]
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowElevation": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true
    }
}
